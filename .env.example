# Copy to .env.local for local development (never commit real keys; .env* is git-ignored).
# On Vercel, set these in Project Settings -> Environment Variables instead.
GEMINI_API_KEY=your-gemini-api-key-here
# Optional. Default: gemini-3.5-flash-lite (checked against Google's model list on 11 Oct 2026).
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional. Total time allowed per question, including retries, in milliseconds (3000 to 55000).
GEMINI_TIMEOUT_MS=25000
# Optional. Extra origins allowed to call /api/gemini, comma-separated. Same-origin is always allowed.
ALLOWED_ORIGINS=
